+
+
+async def test_saved_controller_identity_on_reconnect(companion_conf, companion_state):
+    from pyatv.storage.memory_storage import MemoryStorage
+
+    storage = MemoryStorage()
+    settings = await storage.get_settings(companion_conf)
+    settings.info.rp_id = "0123456789ab"
+    settings.info.device_id = "02:01:23:45:67:89"
+    settings.info.name = "Living room bridge"
+    for _ in range(2):
+        atv = await pyatv.connect(
+            companion_conf, asyncio.get_running_loop(), storage=storage
+        )
+        try:
+            wire = companion_state.system_info
+            assert (wire["_i"], wire["_pubID"], wire["name"], wire["_sv"]) == (
+                settings.info.rp_id,
+                settings.info.device_id,
+                settings.info.name,
+                "715.2",
+            )
+        finally:
+            await asyncio.gather(*atv.close())
