+++ b/tests/protocols/companion/test_companion_functional.py
@@ -456,3 +456,19 @@ async def test_saved_controller_identity_on_reconnect(companion_conf, companion_
             )
         finally:
             await asyncio.gather(*atv.close())
+
+
+async def test_converted_hap_pairing_connects(companion_conf, companion_state):
+    from pyatv.auth import convert
+
+    service = companion_conf.get_service(Protocol.Companion)
+    store = convert.to_doubletake(service.credentials, device_id="receiver")
+    service.credentials = convert.companion_credentials(
+        convert.from_doubletake(store, device_id="receiver")
+    )
+    atv = await pyatv.connect(companion_conf, asyncio.get_running_loop())
+    try:
+        await atv.remote_control.menu()
+        assert companion_state.latest_button == "menu"
+    finally:
+        await asyncio.gather(*atv.close())
