diff --git a/tests/protocols/companion/test_companion_functional.py b/tests/protocols/companion/test_companion_functional.py
index db55780..8884ed5 100644
--- a/tests/protocols/companion/test_companion_functional.py
+++ b/tests/protocols/companion/test_companion_functional.py
@@ -472,3 +472,42 @@ async def test_converted_hap_pairing_connects(companion_conf, companion_state):
         assert companion_state.latest_button == "menu"
     finally:
         await asyncio.gather(*atv.close())
+
+
+async def test_airplay_pin_pairing_used_on_companion(companion_conf, companion_state):
+    from pyatv.auth.convert import companion_credentials
+    from tests.fake_device import FakeAppleTV
+    from tests.fake_device.airplay import DEVICE_PIN
+
+    loop = asyncio.get_running_loop()
+    fake = FakeAppleTV(loop, test_mode=False)
+    fake.add_service(Protocol.AirPlay)
+    await fake.start()
+    try:
+        conf = AppleTV("127.0.0.1", "Paired TV")
+        conf.add_service(
+            ManualService(
+                "airplay",
+                Protocol.AirPlay,
+                fake.get_port(Protocol.AirPlay),
+                {"features": "0x00000000,0x00010000"},
+            )
+        )
+        pairing = await pyatv.pair(conf, Protocol.AirPlay, loop)
+        try:
+            await pairing.begin()
+            pairing.pin(DEVICE_PIN)
+            await pairing.finish()
+            companion_conf.get_service(Protocol.Companion).credentials = (
+                companion_credentials(pairing.service.credentials)
+            )
+        finally:
+            await pairing.close()
+        atv = await pyatv.connect(companion_conf, loop)
+        try:
+            await atv.remote_control.menu()
+            assert companion_state.latest_button == "menu"
+        finally:
+            await asyncio.gather(*atv.close())
+    finally:
+        await fake.stop()
